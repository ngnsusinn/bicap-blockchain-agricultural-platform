# ------------------------------------------------------------------------
# BICAP Environment Variables Template (.env)
# Rename this file to '.env' and fill in your credentials.
# Variable names MUST match application.properties (SPRING_DATASOURCE_*, not DB_*).
# ------------------------------------------------------------------------

# Application Port
SERVER_PORT=8080

# ------------------------------------------------------------------------
# Database Configurations (MySQL)
# ------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://your-cloud-mysql-host:3306/bicap_db?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_cloud_user
SPRING_DATASOURCE_PASSWORD=your_cloud_password

# ------------------------------------------------------------------------
# JPA / Hibernate
# 'update' only for demos/tests; use 'validate' in production and manage the
# schema with migrations.
# ------------------------------------------------------------------------
DDL_AUTO=validate

# ------------------------------------------------------------------------
# JWT Secret and Expiration (in milliseconds, default is 24 hours)
# REQUIRED — the backend will not start without it.
# Generate with:  openssl rand -base64 48
# ------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-base64-value-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
RETAILER_ACCESS_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000
VERIFICATION_TOKEN_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------
# Retailer email verification (BICAP-36)
# ------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@bicap.example
FRONTEND_URL=http://localhost:5174
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------
# Payment Gateway (Sepay) — REQUIRED, the backend will not start without it.
# ------------------------------------------------------------------------
SEPAY_ACCOUNT_NO=123456789
SEPAY_BANK_NAME=MBBank
SEPAY_API_KEY=replace-with-your-real-sepay-api-key

# ------------------------------------------------------------------------
# Redis Caching Configurations (optional)
# ------------------------------------------------------------------------
SPRING_REDIS_HOST=your-cloud-redis-host
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your_cloud_redis_password
SPRING_REDIS_SSL=true

# ------------------------------------------------------------------------
# Frontend API Connection Endpoint
# Set this to the online API address where the backend 'api' service is exposed.
# The backend origin is inferred from this value (the /api/admins path is stripped).
# ------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/admins

# ------------------------------------------------------------------------
# Admin Web portal URL — liên kết "Mở Bảng điều khiển Admin" trên trang
# đăng nhập của Farm Portal (frontend). Mặc định '/admin/' vì cả 2 frontend
# được Spring Boot phục vụ chung một port (chạy build-web.bat rồi chạy backend).
# Chỉ cần đặt giá trị này khi Admin Web được deploy ở origin KHÁC.
# ------------------------------------------------------------------------
VITE_ADMIN_PORTAL_URL=/admin/
