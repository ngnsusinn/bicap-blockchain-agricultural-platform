# ------------------------------------------------------------------------
# BICAP Environment Variables Template (.env)
# Rename this file to '.env' and fill in your cloud credentials
# ------------------------------------------------------------------------

# Cloud MySQL Database Configurations
SPRING_DATASOURCE_URL=jdbc:mysql://your-cloud-mysql-host:3306/bicap_db?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_cloud_user
SPRING_DATASOURCE_PASSWORD=your_cloud_password

# Cloud Redis Caching Configurations
SPRING_REDIS_HOST=your-cloud-redis-host
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your_cloud_redis_password
SPRING_REDIS_SSL=true

# Frontend API Connection Endpoint
# Set this to the online API address where the backend 'api' service is exposed
VITE_API_BASE_URL=http://localhost:8080/api/admins
