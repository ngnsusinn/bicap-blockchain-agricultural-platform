# ------------------------------------------------------------------------
# BICAP Environment Variables Template (.env)
#
# CẤU HÌNH KIỂU PRODUCTION — KHÔNG có secret sinh tạm, KHÔNG có fallback:
#   * JWT_SECRET / SEPAY_API_KEY thiếu hoặc còn là placeholder ⇒ backend KHÔNG khởi động.
#   * MySQL + Redis là dịch vụ bắt buộc (server remote). Redis không kết nối được ⇒
#     backend không khởi động (trừ khi chủ động đặt APP_CACHE_ENABLED=false cho test).
#   * BLOCKCHAIN_MODE phải là `live` (mock chỉ cho test/CI, phải bật ALLOW_SIMULATION=true).
#   * BLOCKCHAIN_EXPORT_MODE phải là `vechain` (stub `local` cũng bị chặn như trên).
#
# Sao chép file này thành `.env` (đã .gitignore) rồi điền giá trị thật.
# Chạy backend kèm .env:
#   PowerShell :  .\dev\run-backend.ps1
#   bash       :  set -a; source .env; set +a; cd backend && mvn spring-boot:run
# (hoặc dùng EnvFile plugin của IDE)
# ------------------------------------------------------------------------

# Application Port
SERVER_PORT=8080

# ------------------------------------------------------------------------
# Database — MySQL REMOTE
# Giữ nguyên '&' trong JDBC URL; file .env không cần quote vì không qua shell.
# Production thật nên chạy DDL_AUTO=validate + migration (docs/sql/).
# ------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://db-host.example.com:3306/bicap_db?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=bicap_app
SPRING_DATASOURCE_PASSWORD=replace-with-real-db-password
DDL_AUTO=update

# ------------------------------------------------------------------------
# Redis REMOTE (cache BICAP-79)
# SPRING_REDIS_SSL=true nếu server Redis yêu cầu TLS (managed Redis thường bật).
# ------------------------------------------------------------------------
SPRING_REDIS_HOST=redis-host.example.com
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=replace-with-real-redis-password
SPRING_REDIS_SSL=false
APP_CACHE_ENABLED=true
APP_CACHE_TTL_SECONDS=60

# ------------------------------------------------------------------------
# JWT — BẮT BUỘC. Sinh bằng:  openssl rand -base64 48
# Giá trị template/đã từng public trong repo sẽ bị TỪ CHỐI khởi động.
# ------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-base64-value-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
RETAILER_ACCESS_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------
# Rate limiter: chỉ bật true khi có reverse proxy tin cậy ghi lại X-Forwarded-For.
# ------------------------------------------------------------------------
TRUST_FORWARDED_FOR=false

# ------------------------------------------------------------------------
# ------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5174
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------
# Sepay — webhook thanh toán. BẮT BUỘC. Key này backend so khớp với header
# "Authorization: Apikey <key>" do Sepay gửi ⇒ dán key thật từ dashboard Sepay.
# Sinh nhanh một key mạnh:  openssl rand -hex 32
# ------------------------------------------------------------------------
SEPAY_ACCOUNT_NO=0362600223
SEPAY_BANK_NAME=VietinBank
SEPAY_API_KEY=replace-with-your-real-sepay-api-key

# ------------------------------------------------------------------------
# Blockchain VeChainThor (BICAP-74/80/81) — LIVE, không giả lập.
# ALLOW_SIMULATION=true chỉ dành cho test/CI.
# Ví signer cần VTHO trả gas: nạp tại https://faucet.vecha.in
#   kiểm tra số dư:  https://testnet.vechain.org/accounts/<địa chỉ ví>
# Sinh ví mới: java -cp "backend/target/classes;<bcprov.jar>" dev/tools/WalletGen.java
# ------------------------------------------------------------------------
BLOCKCHAIN_MODE=live
ALLOW_SIMULATION=false
BLOCKCHAIN_NODE_URL=https://testnet.vechain.org
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_GAS_PRICE_COEF=0
BLOCKCHAIN_GAS_ATTEST=53000
BLOCKCHAIN_GAS_DEPLOY=10000000
BLOCKCHAIN_EXPIRATION=720
BLOCKCHAIN_CONFIRM_INTERVAL_MS=15000
BLOCKCHAIN_RETRY_INTERVAL_MS=60000
BLOCKCHAIN_EXPORT_MODE=vechain

# ------------------------------------------------------------------------
# Web app → backend (build-time variable của web/)
# ------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
