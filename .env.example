# ------------------------------------------------------------------------
# BICAP Environment Variables Template (.env)
# Rename this file to '.env' and fill in your credentials.
# Variable names MUST match application.properties (SPRING_DATASOURCE_*, not DB_*).
# ------------------------------------------------------------------------

# Application Port
SERVER_PORT=8080

# ------------------------------------------------------------------------
# Database Configurations (MySQL)
#
# LOCAL DEV: comment out these three lines (and DDL_AUTO below) to let the
# backend use its embedded H2 default. If you export them as-is the app tries
# to reach a non-existent cloud host and Hibernate fails at startup with
# "Unable to determine Dialect without JDBC metadata".
# Also note the '&' characters: keep the value quoted if you source this file,
# otherwise bash treats '&' as a background operator.
# ------------------------------------------------------------------------
# SPRING_DATASOURCE_URL='jdbc:mysql://your-cloud-mysql-host:3306/bicap_db?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true'
# SPRING_DATASOURCE_USERNAME=your_cloud_user
# SPRING_DATASOURCE_PASSWORD=your_cloud_password

# ------------------------------------------------------------------------
# JPA / Hibernate
# 'update' only for demos/tests; use 'validate' in production and manage the
# schema with migrations (see docs/sql/).
# ------------------------------------------------------------------------
# DDL_AUTO=validate

# ------------------------------------------------------------------------
# JWT Secret and Expiration (in milliseconds, default is 24 hours)
# REQUIRED in production. If you leave JWT_SECRET empty the backend starts with a
# random per-process development secret (tokens die on restart). A template or
# repository-known value is REJECTED at startup (C-1 hardening).
# Generate with:  openssl rand -base64 48
# ------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-base64-value-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
RETAILER_ACCESS_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000
VERIFICATION_TOKEN_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------
# Trust X-Forwarded-For for the auth rate limiter (M-7/CR-06)
# Leave false unless a trusted reverse proxy overwrites the header.
# If it is true while clients can reach the backend directly, the 30 req/min
# auth limit can be bypassed by rotating the header.
# ------------------------------------------------------------------------
TRUST_FORWARDED_FOR=false

# ------------------------------------------------------------------------
# Retailer email verification (BICAP-36)
# ------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@bicap.example
FRONTEND_URL=http://localhost:5174
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------
# Payment Gateway (Sepay) — REQUIRED for real payments.
# A template/repository-known key (including the placeholder below) is REJECTED
# at startup; leave it empty in dev to get a random per-process key.
# ------------------------------------------------------------------------
SEPAY_ACCOUNT_NO=0362600223
SEPAY_BANK_NAME=VietinBank
SEPAY_API_KEY=replace-with-your-real-sepay-api-key

# ------------------------------------------------------------------------
# Redis Caching Configurations (optional)
# If Redis is unreachable at startup the app automatically falls back to an
# in-memory cache (logged as "Cache provider: IN-MEMORY fallback").
# LOCAL DEV: comment these out as well — pointing at a non-existent host just
# adds a 2s connect timeout per start before the fallback kicks in.
# ------------------------------------------------------------------------
# SPRING_REDIS_HOST=your-cloud-redis-host
# SPRING_REDIS_PORT=6379
# SPRING_REDIS_PASSWORD=your_cloud_redis_password
# SPRING_REDIS_SSL=true
# Cache behavior
APP_CACHE_ENABLED=true
APP_CACHE_TTL_SECONDS=60

# ------------------------------------------------------------------------
# Blockchain VeChainThor (BICAP-74/80)
# BLOCKCHAIN_MODE=mock : dev/CI — simulated hashes, no network (default)
# BLOCKCHAIN_MODE=live : real signed transactions broadcast to the node.
#   Requires BLOCKCHAIN_PRIVATE_KEY = hex private key of the signer wallet
#   (the wallet must hold VTHO to pay gas; get testnet VET/VTHO at
#    https://faucet.vecha.in). Background jobs confirm receipts every 15s and
#   auto-retry failures every 60s (max 3 attempts).
#
# NOTE — the app does NOT read this file by itself. Either export the variables
#   (set -a; source .env; set +a) or load them through your IDE's EnvFile plugin.
# ------------------------------------------------------------------------
BLOCKCHAIN_MODE=mock
# Public testnet node (verified reachable). For a local thor solo node use
# http://localhost:8669 — it ships with pre-funded accounts.
BLOCKCHAIN_NODE_URL=https://testnet.vechain.org
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_GAS_ATTEST=53000
BLOCKCHAIN_GAS_DEPLOY=10000000
BLOCKCHAIN_EXPIRATION=720
BLOCKCHAIN_CONFIRM_INTERVAL_MS=15000
BLOCKCHAIN_RETRY_INTERVAL_MS=60000
# "vechain" (default) anchors exports through BlockchainService — a real broadcast
# when BLOCKCHAIN_MODE=live. "local" is a dev-only SHA-256 stub.
BLOCKCHAIN_EXPORT_MODE=vechain

# ------------------------------------------------------------------------
# Web app → backend connection (build-time variable of web/)
# Set this to the origin where the backend API is exposed. Any trailing
# /api/... path is stripped, so both the portal (/api/**) and the admin
# dashboard (/api/admins, /api/admin/**) use the same value.
# ------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
