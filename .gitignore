# BICAP - Blockchain Agricultural Platform
# Comprehensive .gitignore for Spring Boot Backend + React Frontend + Monorepo

# ── IDEs & Editors ──
.vscode/
.idea/
*.iws
*.iml
*.ipr
*.swp
*.swo
*~
.classpath
.project
.settings/
.nbproject/

# ── AI Agents & Dev Tooling ──
.antigravity/
.gemini/
.claude/
.cursor/

# ── Java & Maven Build Outputs ──
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/timing.properties
!.mvn/wrapper/maven-wrapper.jar

# ── Node.js / Frontend Build Outputs (admin-web, frontend, etc.) ──
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
.nuxt/
.tscache/
.eslintcache
.stylelintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment & Secret Files ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# ── OS & System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Blockchain & Smart Contracts (if applicable) ──
artifacts/
cache/
typechain/
typechain-types/
coverage/
coverage.json
.openzeppelin/
